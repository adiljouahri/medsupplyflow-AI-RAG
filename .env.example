# Copy to .env. All values are synthetic demo values.
# Never commit .env. Rotate the internal API key for any real deployment.
POSTGRES_PASSWORD=demo-password
# Keep the password in DATABASE_URL in sync with POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://medsupply:demo-password@postgres:5432/medsupplyflow
CHROMA_HOST=chromadb
CHROMA_PORT=8000
INTERNAL_API_KEY=demo-internal-api-key
CONFIDENCE_THRESHOLD=0.85
MAX_UPLOAD_MB=20
MAX_ROWS=500

# LiteLLM model string. Pick one provider:
# OpenAI: openai/gpt-4o-mini
# Gemini: gemini/gemini-1.5-flash
# Local Ollama: ollama/llama3.2
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=

# Optional DeepEval AI test. Without a key, pytest skips it.
DEEPEVAL_MODEL=gpt-4o-mini
DEEPEVAL_API_KEY=

# Optional setting for a host-side Ollama runtime.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Advanced Sentence Transformers v6.0 retrieval. Model weights are downloaded
# at runtime unless the Docker image or a mounted cache already contains them.
MULTI_VECTOR_MODEL=lightonai/mLateOn
VISUAL_MODEL=vidore/colpali-v1.3
